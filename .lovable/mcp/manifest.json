      {
        "name": "create_campaign",
        "title": "Criar campanha",
        "description": "Cria uma campanha em rascunho com template de mensagem e regras de janela/throttle. Depois use add_campaign_targets e set_campaign_status.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 2,
              "maxLength": 120
            },
            "template": {
              "type": "string",
              "minLength": 1,
              "description": "Mensagem com variáveis no formato {{nome}}."
            },
            "cloud_template_id": {
              "description": "Template aprovado do WhatsApp Cloud, quando aplicável.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "cloud_template_variables": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "scheduled_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            },
            "window_start_hour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23
            },
            "window_end_hour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23
            },
            "max_per_hour": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "max_per_day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "throttle_min_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            },
            "throttle_max_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            },
            "pause_on_reply": {
              "type": "boolean"
            },
            "opt_out_keywords": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "instance_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "name",
            "template"
          ]
        },
        "outputSchema": null
      },
