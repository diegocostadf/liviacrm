        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "phone": {
              "type": "string",
              "minLength": 8,
              "description": "Telefone com DDI+DDD."
            },
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "company": {
              "type": "string"
            },
            "job_title": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "lead_status": {
              "type": "string",
              "enum": [
                "novo",
                "engajado",
                "inscrito",
                "perdido"
              ]
            },
            "history": {
              "description": "Anotação/histórico livre do contato.",
              "type": "string"
            },
            "opted_out": {
              "type": "boolean"
            }
          },
          "required": [
            "phone"
          ]
        },
        "outputSchema": null
      },
